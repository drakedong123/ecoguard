{
  "manifest_version": 3,
  "name": "EcoGuard",
  "version": "0.1.0",
  "description": "Automatically unload idle tabs with conservative page safety checks and local controls.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms", "downloads"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["page-safety.js"],
    "run_at": "document_start",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "EcoGuard", "default_popup": "popup.html" },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
